    <text source="Analyze query">Анализ запроса</text>
    <text source="Query suggestions">Рекомендации для запроса</text>
    <text source="Select database">Выберите базу данных</text>
    <text source="Copy">Копировать</text>
    <text source="Copy rows">Копировать строки</text>
    <text source="Share">Доля</text>
    <text source="Table access order">Порядок доступа к таблицам</text>
    <text source="Rows are estimates per lookup.">Показано оценочное число строк на один поиск.</text>
    <text source="Type  %1">Тип  %1</text>
    <text source="Key  %1">Ключ  %1</text>
    <text source="Rows  %1">Строки  %1</text>
    <text source="Extra  %1">Дополнительно  %1</text>
